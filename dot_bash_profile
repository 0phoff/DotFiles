# Path
######
if [ -d "/opt/homebrew/bin" ] ; then
    export PATH=$PATH:/opt/homebrew/bin
fi


# User path
###########
if [ -d "$HOME/bin" ] ; then
    export PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ] ; then
    export PATH="$HOME/.local/bin:$PATH"
fi


# Bashrc
########
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
