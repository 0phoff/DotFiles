" SETTINGS
""""""""""
filetype plugin indent on
syntax on
runtime macros/matchit.vim

set viminfo='100,\"300,<50,s10,h,:20    " 100 search histories, 300 register entries, 50 file marks, store 10 file marks, store history of file, store 20 command history
set nocompatible                        " Use VIM instead of Vi default settings
set encoding=utf-8                      " Default file encoding
set hidden                              " Allow to leave unsaved buffers
set noswapfile                          " Do not use swap files
set mouse=nv                            " Enable mouse in normal and visual mode
set linebreak                           " Only wrap at whitespace
set autoread                            " Automatically reload file if it changed outside of vim
set sidescrolloff=5                     " Keep 5 columns from cursor visible
set nowriteany                          " Do not allow to write file that needs '!'
set nowrap                              " Disable line wrapping
set ttimeout                            " time out for key codes
set ttimeoutlen=5                       " wait up to 100ms after Esc for special key

set ignorecase                          " Searching is case insensitive
set smartcase                           " Searching is case sensitive if there is a capital
set incsearch                           " Set incremetal searching
set hlsearch                            " Highlight search

set history=500                         " Longer history
set undolevels=500                      " More undos
set undoreload=10000                    " Persistent undos

set tabstop=2                           " Tabs are 2 characters long
set softtabstop=-1                      " When entering tab -> #shiftwidth spaces are inserted
set shiftwidth=2                        " Number of spaces
set expandtab                           " Expand tab to spaces
set cindent                             " Smart auto indentation
set backspace=indent,eol,start          " Allow backspace over everything in insert mode
set shiftround                          " Use multiple of shiftwidth when indenting with '<' and '>'

set complete+=d
set path=.,**                           " Search down into subfolders
set wildmenu                            " Display all matching files when tabbing
set wildmode=full
set completeopt=menu                    " Set completion to only show popup menu & not preview scratch buffer

set noerrorbells                        " Disable error bell
set novisualbell                        " Disable visual bell
set belloff=all                         " No beep

set number                              " Set linenumbers
set relativenumber                      " Relative linenumbers
set cursorline                          " Highlight current line
set showtabline=2                       " Always show tab
set laststatus=2                        " Always show statusbar
set showcmd                             " Show incomplete command
set noshowmode                          " Dont show mode -> already in statusline
set conceallevel=0                      " Don't hide text


" Key mappings
""""""""""""""
map <SPACE> <leader>
inoremap jj <ESC>
nnoremap <silent> <Leader>w :w <CR>
nnoremap <silent> <Leader>q :q <CR>
nnoremap <silent> <Leader>x :x <CR>
nnoremap <silent> <Leader>h :nohlsearch <CR>
nnoremap <silent> <Leader>r :set wrap! <CR>
nnoremap <silent> <Leader>n :set relativenumber! <CR>

" Get rid of accidental Ex Mode -> Use gQ if really wanted
nnoremap Q <nop>

" JK move through line wraps in stead of real lines (except when X[j,k] is used)
nnoremap <silent> <expr> j v:count ? 'j':'gj' 
nnoremap <silent> <expr> k v:count ? 'k':'gk'
vnoremap <silent> <expr> j v:count ? 'j':'gj' 
vnoremap <silent> <expr> k v:count ? 'k':'gk'
onoremap <silent> <expr> j v:count ? 'j':'gj' 
onoremap <silent> <expr> k v:count ? 'k':'gk'


" Visuals
"""""""""
" Show current line as bold linenumber
hi CursorLine NONE
hi CursorLineNR cterm=bold ctermbg=NONE guibg=NONE
hi Visual ctermbg=3

" Cursor shape to line in insert mode
let &t_SI = "\e[6 q"
let &t_EI = "\e[2 q"
let &t_SR = "\e[4 q"

" Statusline
function! ModeName()
  let l:mode_map = {
    \ 'n': 'NORMAL',
    \ 'no': 'OPERATOR-PENDING',
    \ 'v': 'VISUAL',
    \ 'V': 'VISUAL LINE',
    \ "\<C-v>": 'VISUAL BLOCK',
    \ 's': 'SELECT',
    \ 'S': 'SELECT LINE',
    \ "\<C-s>": 'SELECT BLOCK',
    \ 'i': 'INSERT',
    \ 'R': 'REPLACE',
    \ 'Rv': 'VIRTUAL REPLACE',
    \ 'c': 'COMMAND',
    \ 'cv': 'VIM EX',
    \ 'ce': 'EX',
    \ 'r': 'PROMPT',
    \ 'rm': 'MORE',
    \ 'r?': 'CONFIRM',
    \ '!': 'SHELL',
    \ 't': 'TERMINAL'
    \ }
  return get(l:mode_map, mode(), 'UNKNOWN')
endfunction

function! GetOptionsStatus(...) abort
  let l:status = ModeName()

  if &paste
    let l:status .= ' [PASTE]'
  endif

  return l:status
endfunction

function! CachedGitBranch() abort
  let l:dir = expand('%:p:h')
  if empty(l:dir)
    return ''
  endif

  if !exists('b:git_branch')
    let l:branch = system('git -C ' . shellescape(l:dir) . ' rev-parse --abbrev-ref HEAD 2>/dev/null')
    let b:git_branch = substitute(l:branch, '\n', '', '')
  endif

  return empty(b:git_branch) ? '' : ' | ' . b:git_branch 
endfunction

hi StatusNormal cterm=reverse gui=reverse
hi StatusBold cterm=bold,reverse gui=bold,reverse

set statusline=%#StatusBold#%{GetOptionsStatus()}\ \|\ %#StatusNormal#%F\ %m%r%h%w%=%l:%c%#StatusBold#%{CachedGitBranch()}
